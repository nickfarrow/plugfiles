#!/bin/bash
# Nick Farrow 2019 (Updated 2024)

VERTICAL=false
XSPLIT=1920  # Assuming 1920x1080 resolution for the first monitor
LEFT='alt+F11'
RIGHT='alt+F12'
PAST=$RIGHT

while getopts "vp:" opt; do
    case ${opt} in
        v )
            VERTICAL=true
            XSPLIT=1080
            
            # Swap LEFT and RIGHT
            TMPSTORE=$LEFT
            LEFT=$RIGHT
            RIGHT=$TMPSTORE
        ;;
        p )
            XSPLIT=$OPTARG
        ;;
        \? )
            echo "Usage: $0 [-v] [-p XSPLIT]" 1>&2
            echo "  -v: Vertical mode" 1>&2
            echo "  -p XSPLIT: Set split position (default: 1920)" 1>&2
            exit 1
        ;;
    esac
done

obs &


while true; do
    if [ "$VERTICAL" = true ]; then
        COORD=$(xdotool getmouselocation --shell | grep Y= | cut -d= -f2)
    else
        COORD=$(xdotool getmouselocation --shell | grep X= | cut -d= -f2)
    fi

    WINDOWID=$(xdotool search --name "OBS" | tail -1)

    if [ -z "$WINDOWID" ]; then
        echo "OBS window not found. Exiting."
        exit 1
    fi

    if [ "$COORD" -le "$XSPLIT" ] && [ "$PAST" = "$RIGHT" ]; then
        xdotool key --window $WINDOWID $LEFT
        PAST=$LEFT
        echo "CHANGE LEFT"
    elif [ "$COORD" -gt "$XSPLIT" ] && [ "$PAST" = "$LEFT" ]; then
        xdotool key --window $WINDOWID $RIGHT
        PAST=$RIGHT
        echo "CHANGE RIGHT"
    fi

    sleep 0.01
done
