# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'


alias ls="ls -hN --color=auto --group-directories-first"
alias grep="grep --color=auto"

# DEL
alias uskeys='setxkbmap -layout us'
alias screenflip='xrandr --output DVI-I-0 --right-of HDMI-0'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

alias scr='import'
alias chrome='google-chrome'
alias chr='google-chrome'
alias ra='ranger'

alias cbnt='feh --randomize --bg-fill ~/Pictures/Wallpapers/*'
#alias cb='wal -i ~/Pictures/Wallpapers/ --saturate 0.65' 
alias cb='wal -i ~/Pictures/Wallpapers/ --saturate 0.5 --backend colorthief'
#alias cbs='wal -i ~/Pictures/Wallpapers/ --saturate'
alias monitorstart='xrandr --output HDMI-0 --auto --above eDP-1-1 && polylaunch && cb'

alias STARWARS='telnet towel.blinkenlights.nl'

alias ytdl="yt-dlp --write-thumbnail --add-metadata"

alias mountin='sudo mount /dev/sda1 /media/sea; sudo mount /dev/sdb2 /media/SSD'

alias pipu='python3 -m pip install --user'

alias gs='git status'
alias gl='git log'
alias grs='git restore --staged .'
alias sps='sudo prime-switch && xinit'

alias whatismyip='curl https://ifconfig.me/'


# Electrum & Electrum personal server
alias elec='LD_LIBRARY_PATH=/home/nick/install/electrum-4.0.5/contrib/secp256k1/dist/lib electrum --oneserver --server localhost:50002:s | ssh pi@192.168.0.252 -L 50002:localhost:50002 cat'

# shorthand for piping to clipboard
alias clip='copyq copy -'
